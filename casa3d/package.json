{
  "name": "casa3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Casa3D — planta baixa, projeção 3D da casa e cálculo de telhado (Electron, Windows, medidas em metros)",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "br.casa3d.app",
    "productName": "Casa3D",
    "directories": { "output": "release" },
    "files": ["out/**"],
    "extraResources": [
      { "from": "native/skp-converter/bin", "to": "skp-converter", "filter": ["**/*"] }
    ],
    "fileAssociations": [
      { "ext": "casa3d", "name": "Projeto Casa3D", "role": "Editor" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
